{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/claude",
      "destination": "/api/claude.js"
    },
    {
      "source": "/api/groq",
      "destination": "/api/groq.js"
    },
    {
      "source": "/api/whisper",
      "destination": "/api/whisper.js"
    },
    {
      "source": "/api/assemblyai",
      "destination": "/api/assemblyai.js"
    }
  ],
  "headers": [
    {
      "source": "/dfu/(seg|tissue|model|model-roi)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/dfu",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}